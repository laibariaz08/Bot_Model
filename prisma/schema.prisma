generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String @id @default(cuid())
  name        String
  phoneNumber String @unique

  // WhatsApp Configuration
  whatsappPhoneNumberId String?
  whatsappBusinessPhone String? @unique
  whatsappAccessToken   String? // Store encrypted in production
  whatsappCatalogId     String?
  whatsappIsActive      Boolean @default(false)

  // Instagram Configuration
  instagramPageId      String?  @unique
  instagramFbPageId    String?
  instagramAccessToken String?
  instagramIsActive    Boolean @default(false)

  // Messenger Configuration
  messengerPageId      String?  @unique
  messengerAccessToken String?
  messengerIsActive    Boolean @default(false)

  // AI Agent Configuration
  agentName         String?
  agentInstructions String?
  websiteUrl        String?

  createdAt DateTime @default(now())

  users            User[]
  chats            Chat[]
  knowledgeBase    KnowledgeBase[]
  workflows        Workflow[]
  workflowSessions WorkflowSession[]
  tickets          Ticket[]

  // Meta Ads Manager
  metaConnections    MetaConnection[]
  metaAdAccounts     MetaAdAccount[]
  adCampaigns        AdCampaign[]
  adSets             AdSet[]
  metaAds            MetaAd[]
  adCreatives        AdCreative[]
  adInsightSnapshots AdInsightSnapshot[]
  leadForms          LeadForm[]
  leadSubmissions    LeadSubmission[]
  audienceConfigs    AudienceConfig[]
  adOperations       AdOperation[]

  @@map("businesses")
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(MEMBER)

  // Two-Factor Authentication
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  // Account lockout
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         Contact[]
  whatsappAccounts WhatsAppAccount[]
  createdWorkflows Workflow[]
  tickets          Ticket[]
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  ticketMessages   TicketMessage[] @relation("TicketMessageSender")

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  @@map("users")
}

model Chat {
  id             String   @id @default(cuid())
  userPhone      String
  businessId     String
  createdAt      DateTime @default(now())
  isResolved     Boolean  @default(false)
  isRequesting   Boolean  @default(false)
  channel        String   @default("whatsapp") // "whatsapp" | "instagram" | "messenger"
  userIdentifier String?  // Instagram-scoped user ID (IGSID) for Instagram chats

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages         Message[]
  workflowSessions WorkflowSession[]

  @@map("chats")
}

model Message {
  id                Int      @id @default(autoincrement())
  chatId            String
  sender            String   // "user" or "bot" or "assistant"
  content           String
  messageType       String   @default("text") // "text", "interactive_button", "interactive_list", "image", "document"
  metadata          Json?    // Structured payload for interactive messages (button configs, list configs, etc.)
  whatsappMessageId String?  // Track Meta message ID
  createdAt         DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}


model KnowledgeBase {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("knowledge_base")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  tags      String[] @default([])
  status    String   @default("active")
  messages  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model WhatsAppAccount {
  id            String   @id @default(cuid())
  phoneNumberId String
  wabaId        String
  accessToken   String
  businessName  String?
  status        String   @default("CONNECTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

enum Role {
  OWNER
  MEMBER
}

// ============================================================
// WORKFLOW SYSTEM
// ============================================================

model Workflow {
  id          String              @id @default(cuid())
  businessId  String
  name        String
  description String?
  status      WorkflowStatus      @default(DRAFT)

  // Trigger configuration
  triggerType   WorkflowTriggerType
  triggerConfig Json?

  // Variable definitions declared by this workflow
  variables Json?

  // The workflow graph
  nodes Json
  edges Json

  // Versioning
  version     Int       @default(1)
  publishedAt DateTime?

  // Channel targeting
  channel String @default("whatsapp")

  // Template system
  isTemplate       Boolean @default(false)
  templateCategory String?

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator  User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sessions WorkflowSession[]

  @@index([businessId, status])
  @@index([isTemplate, templateCategory])
  @@map("workflows")
}

model WorkflowSession {
  id              String        @id @default(cuid())
  chatId          String
  businessId      String
  workflowId      String
  workflowVersion Int

  // Snapshot of the published workflow at session start
  workflowSnapshot Json

  // Current execution state
  currentNodeId String?
  status        SessionStatus   @default(ACTIVE)

  // Runtime variable store
  variables Json @default("{}")

  // Execution context
  context Json @default("{}")

  // Visited node trail
  history Json @default("[]")

  // Input retry tracking
  retryCount Int @default(0)
  maxRetries Int @default(3)

  // Activity tracking
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  // Relations
  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs     WorkflowLog[]

  @@index([chatId, status])
  @@index([businessId])
  @@index([workflowId])
  @@index([status, lastActivityAt])
  @@map("workflow_sessions")
}

model WorkflowLog {
  id        String   @id @default(cuid())
  sessionId String
  nodeId    String
  nodeType  String
  input     Json?
  output    Json?
  status    String   // "SUCCESS", "ERROR", "SKIPPED"
  error     String?
  duration  Int?     // ms
  createdAt DateTime @default(now())

  session WorkflowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("workflow_logs")
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowTriggerType {
  KEYWORD
  NEW_CONVERSATION
  BUTTON_CLICK
  MANUAL
  WEBHOOK
  CONTACT_EVENT
}

enum SessionStatus {
  ACTIVE
  WAITING_INPUT
  COMPLETED
  FAILED
  HANDED_OVER
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

model Ticket {
  id         String       @id @default(cuid())
  subject    String
  status     TicketStatus @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  category   String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  closedAt   DateTime?

  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  messages   TicketMessage[]

  @@index([businessId, status])
  @@index([userId])
  @@index([assigneeId])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User   @relation("TicketMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ============================================================
// META ADS MANAGER
// ============================================================

enum MetaConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum AdEntityStatus {
  DRAFT
  PAUSED
  ACTIVE
  ARCHIVED
  DELETED
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model MetaConnection {
  id           String               @id @default(cuid())
  businessId   String
  metaAppId    String
  metaUserId   String
  accessToken  String
  tokenExpiry  DateTime?
  scopes       String[]
  status       MetaConnectionStatus @default(ACTIVE)
  lastSyncAt   DateTime?
  errorMessage String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business     Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adAccounts   MetaAdAccount[]
  adOperations AdOperation[]

  @@unique([businessId, metaAppId])
  @@index([businessId, status])
  @@map("meta_connections")
}

model MetaAdAccount {
  id               String   @id @default(cuid())
  connectionId     String
  businessId       String
  metaAccountId    String
  name             String
  currency         String   @default("USD")
  timezone         String   @default("America/New_York")
  accountStatus    Int      @default(1)
  metaBusinessId   String?
  metaPageId       String?
  metaInstagramId  String?
  metaPixelId      String?
  capabilities     String[]
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  connection       MetaConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns        AdCampaign[]
  insightSnapshots AdInsightSnapshot[]
  leadForms        LeadForm[]
  audienceConfigs  AudienceConfig[]

  @@unique([businessId, metaAccountId])
  @@index([businessId])
  @@map("meta_ad_accounts")
}

model AdCampaign {
  id                  String         @id @default(cuid())
  adAccountId         String
  businessId          String
  metaCampaignId      String?
  name                String
  objective           String?
  status              AdEntityStatus @default(DRAFT)
  effectiveStatus     String?
  specialAdCategories String[]
  dailyBudget         Float?
  lifetimeBudget      Float?
  startTime           DateTime?
  endTime             DateTime?
  bidStrategy         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  adAccount MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adSets    AdSet[]

  @@index([businessId])
  @@index([adAccountId, status])
  @@map("ad_campaigns")
}

model AdSet {
  id                String         @id @default(cuid())
  campaignId        String
  businessId        String
  metaAdSetId       String?
  name              String
  status            AdEntityStatus @default(DRAFT)
  dailyBudget       Float?
  lifetimeBudget    Float?
  optimizationGoal  String?
  billingEvent      String?
  bidAmount         Float?
  targeting         Json?
  placements        Json?
  promotedObject    Json?
  startTime         DateTime?
  endTime           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ads      MetaAd[]

  @@index([businessId])
  @@index([campaignId, status])
  @@map("ad_sets")
}

model MetaAd {
  id            String         @id @default(cuid())
  adSetId       String
  businessId    String
  metaAdId      String?
  name          String
  status        AdEntityStatus @default(DRAFT)
  creativeId    String?
  trackingSpecs Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  adSet    AdSet       @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creative AdCreative? @relation(fields: [creativeId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([adSetId, status])
  @@map("meta_ads")
}

model AdCreative {
  id               String   @id @default(cuid())
  businessId       String
  metaCreativeId   String?
  name             String
  title            String?
  body             String?
  callToAction     String?
  linkUrl          String?
  imageUrl         String?
  videoUrl         String?
  thumbnailUrl     String?
  pageId           String?
  instagramActorId String?
  urlTags          String?
  objectType       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ads      MetaAd[]

  @@index([businessId])
  @@map("ad_creatives")
}

model AdInsightSnapshot {
  id            String   @id @default(cuid())
  adAccountId   String
  businessId    String
  dateStart     DateTime
  dateEnd       DateTime
  level         String
  entityId      String
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  spend         Float    @default(0)
  reach         Int      @default(0)
  cpc           Float?
  cpm           Float?
  ctr           Float?
  conversions   Int      @default(0)
  costPerResult Float?
  results       Int      @default(0)
  resultType    String?
  currency      String   @default("USD")
  rawData       Json?
  createdAt     DateTime @default(now())

  adAccount MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([adAccountId, dateStart, dateEnd])
  @@index([entityId, level])
  @@map("ad_insight_snapshots")
}

model LeadForm {
  id            String     @id @default(cuid())
  businessId    String
  adAccountId   String
  metaFormId    String?
  name          String
  status        String     @default("ACTIVE")
  pageId        String?
  questionsJson Json?
  totalLeads    Int        @default(0)
  lastSyncAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adAccount   MetaAdAccount    @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  submissions LeadSubmission[]

  @@unique([businessId, metaFormId])
  @@index([businessId])
  @@map("lead_forms")
}

model LeadSubmission {
  id           String     @id @default(cuid())
  formId       String
  businessId   String
  metaLeadId   String?
  fieldData    Json?
  adId         String?
  adName       String?
  campaignId   String?
  campaignName String?
  platform     String?
  status       LeadStatus @default(NEW)
  assignedTo   String?
  notes        String?
  contactPhone String?
  contactEmail String?
  contactName  String?
  consentData  Json?
  submittedAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  form     LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metaLeadId])
  @@index([businessId, status])
  @@index([formId])
  @@map("lead_submissions")
}

model AudienceConfig {
  id              String   @id @default(cuid())
  businessId      String
  adAccountId     String
  name            String
  description     String?
  type            String
  metaAudienceId  String?
  targeting       Json?
  estimatedSize   Int?
  lastUsedAt      DateTime?
  performanceNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business  Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  adAccount MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("audience_configs")
}

model AdOperation {
  id            String   @id @default(cuid())
  connectionId  String
  businessId    String
  actorId       String?
  operationType String
  entityType    String
  entityId      String?
  metaEntityId  String?
  payload       Json?
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  result        Json?
  error         String?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection MetaConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([connectionId, status])
  @@map("ad_operations")
}
