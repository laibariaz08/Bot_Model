generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id          String @id @default(cuid())
  name        String
  phoneNumber String @unique

  // WhatsApp Configuration
  whatsappPhoneNumberId String?
  whatsappBusinessPhone String? @unique
  whatsappAccessToken   String? // Store encrypted in production
  whatsappIsActive      Boolean @default(false)

  createdAt DateTime @default(now())

  users            User[]
  chats            Chat[]
  knowledgeBase    KnowledgeBase[]
  workflows        Workflow[]
  workflowSessions WorkflowSession[]

  @@map("businesses")
}
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts         Contact[]
  whatsappAccounts WhatsAppAccount[]
  createdWorkflows Workflow[]

  businessId String?
  business   Business? @relation(fields: [businessId], references: [id])

  @@map("users")
}

model Chat {
  id           String   @id @default(cuid())
  userPhone    String
  businessId   String
  createdAt    DateTime @default(now())
  isResolved   Boolean  @default(false)
  isRequesting Boolean  @default(false)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages         Message[]
  workflowSessions WorkflowSession[]

  @@map("chats")
}

model Message {
  id                Int      @id @default(autoincrement())
  chatId            String
  sender            String   // "user" or "bot" or "assistant"
  content           String
  messageType       String   @default("text") // "text", "interactive_button", "interactive_list", "image", "document"
  metadata          Json?    // Structured payload for interactive messages (button configs, list configs, etc.)
  whatsappMessageId String?  // Track Meta message ID
  createdAt         DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("messages")
}


model KnowledgeBase {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("knowledge_base")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  tags      String[] @default([])
  status    String   @default("active")
  messages  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model WhatsAppAccount {
  id            String   @id @default(cuid())
  phoneNumberId String
  wabaId        String
  accessToken   String
  businessName  String?
  status        String   @default("CONNECTED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_accounts")
}

enum Role {
  OWNER
  MEMBER
}

// ============================================================
// WORKFLOW SYSTEM
// ============================================================

model Workflow {
  id          String              @id @default(cuid())
  businessId  String
  name        String
  description String?
  status      WorkflowStatus      @default(DRAFT)

  // Trigger configuration
  triggerType   WorkflowTriggerType
  triggerConfig Json?

  // Variable definitions declared by this workflow
  variables Json?

  // The workflow graph
  nodes Json
  edges Json

  // Versioning
  version     Int       @default(1)
  publishedAt DateTime?

  // Channel targeting
  channel String @default("whatsapp")

  // Template system
  isTemplate       Boolean @default(false)
  templateCategory String?

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creator  User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  sessions WorkflowSession[]

  @@index([businessId, status])
  @@index([isTemplate, templateCategory])
  @@map("workflows")
}

model WorkflowSession {
  id              String        @id @default(cuid())
  chatId          String
  businessId      String
  workflowId      String
  workflowVersion Int

  // Snapshot of the published workflow at session start
  workflowSnapshot Json

  // Current execution state
  currentNodeId String?
  status        SessionStatus   @default(ACTIVE)

  // Runtime variable store
  variables Json @default("{}")

  // Execution context
  context Json @default("{}")

  // Visited node trail
  history Json @default("[]")

  // Input retry tracking
  retryCount Int @default(0)
  maxRetries Int @default(3)

  // Activity tracking
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  completedAt    DateTime?

  // Relations
  chat     Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  logs     WorkflowLog[]

  @@index([chatId, status])
  @@index([businessId])
  @@index([workflowId])
  @@index([status, lastActivityAt])
  @@map("workflow_sessions")
}

model WorkflowLog {
  id        String   @id @default(cuid())
  sessionId String
  nodeId    String
  nodeType  String
  input     Json?
  output    Json?
  status    String   // "SUCCESS", "ERROR", "SKIPPED"
  error     String?
  duration  Int?     // ms
  createdAt DateTime @default(now())

  session WorkflowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("workflow_logs")
}

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowTriggerType {
  KEYWORD
  NEW_CONVERSATION
  BUTTON_CLICK
  MANUAL
  WEBHOOK
  CONTACT_EVENT
}

enum SessionStatus {
  ACTIVE
  WAITING_INPUT
  COMPLETED
  FAILED
  HANDED_OVER
}

